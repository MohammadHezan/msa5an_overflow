entrypoint = "app.py"
run = "python -m pip install -r requirements.txt && python app.py"
modules = ["python-3.12", "web", "nodejs-22"]

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/campus-dashboard: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/campus-connect: expo"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mobile-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mobile-unit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mobile-api"

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m pytest -q"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "mobile-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --dir artifacts/campus-connect typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "mobile-unit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --dir artifacts/campus-connect test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "mobile-api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --dir artifacts/campus-connect test:api"

[workflows.workflow.metadata]
isValidation = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
