# Optional override: copy to artifacts/campus-connect/.env, then restart the mobile workflow.
# In Replit, leave this unset: the managed preview supplies the backend domain automatically.
# Public HTTPS origin of the Campus Connect backend that a physical phone can reach, with no /api path,
# e.g. the Replit dev or deployment URL. A phone's "localhost" points at the phone itself.
# EXPO_PUBLIC_* values are embedded in the app bundle, so never put secrets here.
# EXPO_PUBLIC_API_URL=https://your-backend.example
